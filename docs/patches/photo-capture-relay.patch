+
+
+test('photo draft generation allows only authenticated POST and preserves the text-only request', async () => {
+  const original = globalThis.fetch;
+  const body = JSON.stringify({ source: 'Send the invoice to Alex\nOnly prepare a draft.' });
+  let calls = 0;
+  globalThis.fetch = async (url, options) => {
+    calls++;
+    assert.equal(url, 'https://followthrough.link/api/native/capture');
+    assert.equal(options.method, 'POST');
+    assert.equal(options.redirect, 'manual');
+    assert.equal(options.headers.get('Authorization'), bearer);
+    assert.equal(options.headers.get('OAI-Sites-Authorization'), 'Bearer test-server-only-gateway');
+    assert.equal(options.headers.has('Cookie'), false);
+    assert.equal(options.headers.has('oai-authenticated-user-id'), false);
+    assert.equal(new TextDecoder().decode(options.body), body);
+    return Response.json({ drafts: [{ title: 'Send invoice to Alex', captureMode: 'ai' }] });
+  };
+  try {
+    const unauthorized = request('/api/native/capture', 'POST', body);
+    unauthorized.headers.delete('Authorization');
+    assert.equal((await worker.fetch(unauthorized, env)).status, 401);
+    assert.equal((await worker.fetch(request('/api/native/capture', 'GET'), env)).status, 405);
+    assert.equal((await worker.fetch(request('/api/native/capture?owner=someone', 'POST', body), env)).status, 404);
+    assert.equal(calls, 0);
+    const value = request('/api/native/capture', 'POST', body);
+    value.headers.set('Cookie', 'untrusted-browser-session');
+    value.headers.set('oai-authenticated-user-id', 'another-workspace');
+    const response = await worker.fetch(value, env);
+    assert.equal(response.status, 200);
+    assert.equal((await response.json()).drafts[0].captureMode, 'ai');
+    assert.equal(response.headers.get('Cache-Control'), 'no-store');
+    assert.equal(calls, 1);
+  } finally { globalThis.fetch = original; }
+});
