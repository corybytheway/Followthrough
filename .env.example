# Configure production values with Sites runtime secrets; never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Existing Sites API gateway token; server-only secret for private Shortcut pairing.
SHORTCUT_GATEWAY_TOKEN=

# Server-side calendar credential encryption (64 random hexadecimal characters)
CALENDAR_ENCRYPTION_KEY=
CALENDAR_APP_ORIGIN=https://followthrough.corybytheway.chatgpt.site
